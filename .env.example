# Shared secret the Grok Bot sends as: Authorization: Bearer <value>
GROK_BRIDGE_SECRET=

# Optional: wake your Grok Bot routine after activities
GROK_BOT_WEBHOOK_URL=
GROK_BOT_WEBHOOK_KEY=

# Optional: launch Cursor cloud agents from the bridge
CURSOR_API_KEY=
CURSOR_REPO_URL=
CURSOR_MODEL_ID=

# Optional: public URL Grok Bot should call (ngrok, Vercel, etc.)
BRIDGE_PUBLIC_URL=http://localhost:3000

# Marketplace demo PIN for /post
DEMO_PIN=2244

